{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/format-on-edit.mjs",
        "timeout": 60
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.mjs",
        "matcher": "git",
        "timeout": 30
      }
    ]
  }
}
