# Core
DEBUG=true
ADMIN_API_TOKEN=dev-admin-change-me

# Database / queue (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://cheiro:cheiro@localhost:5432/cheiro
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:5173

# OpenRouter (LLM + embeddings)
OPENROUTER_API_KEY=
